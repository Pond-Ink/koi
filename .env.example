# QQ 开放平台机器人凭证（仅服务端使用）
QQ_BOT_APP_ID=your_app_id
QQ_BOT_APP_SECRET=your_app_secret

# OpenAI Responses API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_responses_api_model

